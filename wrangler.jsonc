{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gajun-onesearch",
  "main": "worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "gajun.kr", "custom_domain": true },
    { "pattern": "www.gajun.kr", "custom_domain": true },
    { "pattern": "gajun.noluga.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
