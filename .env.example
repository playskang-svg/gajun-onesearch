# Copy to an ignored local env file; never commit actual secrets.
# All values below are non-secret (they end up in public page source anyway).
# Leave any of them blank to skip that tag entirely — nothing is hardcoded.

# Google Search Console — HTML tag verification code
VITE_GSC_VERIFICATION=

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Plausible Analytics
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=

# Umami Analytics
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=
